# Development environment
# Copy to .env.dev and fill in real values. Never commit real keys.
#
# Usage:
#   docker compose --env-file .env.dev up -d

DATA_VOLUME=/path/to/csv/data
LOG_LEVEL=DEBUG

# LLM
DEEPSEEK_API_KEY=sk-DEV

# Free LLM providers (fallback chain: openrouter → cerebras → github-models)
# OpenRouter: https://openrouter.ai/settings/keys (no credit card needed)
OPENROUTER_API_KEY=sk-or-v1-DEV
# Cerebras: https://inference.cerebras.ai/ (1M tokens/day free)
CEREBRAS_API_KEY=csk-DEV
# GitHub Models: https://github.com/settings/tokens (Copilot Free tier)
GITHUB_TOKEN=ghp_DEV
