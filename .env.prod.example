# Production environment
# Copy to .env.prod and fill in real values. Never commit real keys.
#
# Usage:
#   docker compose -f docker-compose.vps.yml --env-file .env.prod up -d

DATA_VOLUME=/opt/futebol/data
LOG_LEVEL=INFO

# LLM
DEEPSEEK_API_KEY=sk-PROD

# Free LLM providers (fallback chain: openrouter → cerebras → github-models)
# OpenRouter: https://openrouter.ai/settings/keys (no credit card needed)
OPENROUTER_API_KEY=sk-or-v1-PROD
# Cerebras: https://inference.cerebras.ai/ (1M tokens/day free)
CEREBRAS_API_KEY=csk-PROD
# GitHub Models: https://github.com/settings/tokens (Copilot Free tier)
GITHUB_TOKEN=ghp_PROD
