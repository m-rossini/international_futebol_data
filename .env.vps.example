# VPS deployment environment
# Copy to .env.vps on the VPS and customize

DATA_VOLUME=/opt/futebol/data
LOG_LEVEL=INFO
DOMAIN=orbisplace.co.uk

# LLM — fill in real key before deploying
DEEPSEEK_API_KEY=sk-PROD

# Free LLM providers (fallback chain: openrouter → cerebras → github-models)
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GITHUB_TOKEN=
