#!/bin/sh
# ── Pre-push hook ─────────────────────────────────────────
# Runs API + Web tests via Docker before pushing.
# Fast if Docker images are already built.
#
# Skip with:   git push --no-verify
# Install via: pre-commit install --hook-type pre-push
# Or manual:   ln -sf ../../.githooks/pre-push .git/hooks/pre-push

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "=== Pre-push: running tests ==="
cd "$(git rev-parse --show-toplevel)"

if ! command -v docker >/dev/null 2>&1; then
  echo "${RED}Docker not found — skipping tests.${NC}"
  exit 0
fi

# Build images if missing
if ! docker image inspect international-futebol-data:dev >/dev/null 2>&1; then
  echo "Building API image…"
  make api-build
fi
if ! docker image inspect futebol-web:dev >/dev/null 2>&1; then
  echo "Building Web image…"
  make web-build
fi

make test 2>&1

echo "${GREEN}=== Pre-push: all tests passed ===${NC}"
