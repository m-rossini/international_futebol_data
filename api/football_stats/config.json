{
  "_comment": "Configuration for International Football Stats. Edit and POST /reload to apply changes.",
  "server": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "defaults": {
    "top_scorers_n": 20,
    "biggest_wins_n": 10
  },
  "log_level": "DEBUG",
  "elo": {
    "k_factor": 60,
    "home_advantage": 100,
    "initial_elo": 1500,
    "tournament_weights": {
      "FIFA World Cup": 1.0,
      "FIFA World Cup qualification": 0.67,
      "UEFA Euro": 0.83,
      "UEFA Euro qualification": 0.5,
      "Copa América": 0.83,
      "Copa América qualification": 0.5,
      "African Cup of Nations": 0.67,
      "African Cup of Nations qualification": 0.5,
      "AFC Asian Cup": 0.67,
      "AFC Asian Cup qualification": 0.5,
      "Gold Cup": 0.67,
      "Gold Cup qualification": 0.5,
      "Confederations Cup": 0.83,
      "Olympic Games": 0.5,
      "UEFA Nations League": 0.5,
      "Friendly": 0.17,
      "*": 0.33
    },
    "goal_difference": {
      "enabled": true,
      "cap": 2.0
    }
  },
  "llm": {
    "_comment": "LLM conversation feature. Profiles are tried in priority order (lowest first). Free providers first, paid/local as fallback.",
    "profiles": {
      "openrouter-free": {
        "provider": "openrouter",
        "model": "meta-llama/llama-3.3-70b-instruct:free",
        "api_key_env": "OPENROUTER_API_KEY",
        "max_tokens": 4096,
        "temperature": 0.7,
        "priority": 1
      },
      "cerebras-free": {
        "provider": "cerebras",
        "model": "llama-3.3-70b",
        "api_key_env": "CEREBRAS_API_KEY",
        "max_tokens": 4096,
        "temperature": 0.7,
        "priority": 2
      },
      "github-models-free": {
        "provider": "github-models",
        "model": "gpt-4o-mini",
        "api_key_env": "GITHUB_TOKEN",
        "max_tokens": 4096,
        "temperature": 0.7,
        "priority": 3
      },
      "deepseek-flash": {
        "provider": "deepseek",
        "model": "deepseek-v4-flash",
        "api_key_env": "DEEPSEEK_API_KEY",
        "base_url": null,
        "max_tokens": 4096,
        "temperature": 0.7,
        "priority": 4
      },
      "deepseek-pro": {
        "provider": "deepseek",
        "model": "deepseek-v4-pro",
        "api_key_env": "DEEPSEEK_API_KEY",
        "base_url": null,
        "max_tokens": 8192,
        "temperature": 0.5,
        "priority": 5
      },
      "ollama-local": {
        "provider": "ollama",
        "model": "llama3.1",
        "api_key_env": null,
        "base_url": "http://localhost:11434/v1",
        "max_tokens": 4096,
        "temperature": 0.7,
        "priority": 6
      }
    },
    "system_prompt": [
      "You are a football data analyst assistant with access to 150+ years of international football match data.",
      "You can answer questions about teams, tournaments, matches, goalscorers, head-to-head records, and more.",
      "",
      "Rules:",
      "- Base your answers ONLY on data returned by the tools",
      "- If the data doesn't contain the answer, say so clearly",
      "- Be concise and factual",
      "- Use specific numbers and statistics when available",
      "- When comparing teams, use head-to-head data",
      "- For historical context, use the year-by-year breakdown",
      "- Ideally answers shoul be structure and you should tell from the very start the format",
      "- JSON is on,table - csv like is another one, depending how the answer best fit to these formats"
    ],
    "max_tool_iterations": 5,
    "conversation_ttl_seconds": 3600
  }
}
